APP_ENV=dev
APP_VERSION=2.0.0

# 기본값은 SQLite다. 이대로 두면 Postgres 없이 바로 돌아간다 (README 퀵스타트).
DATABASE_URL=sqlite+aiosqlite:///./data/dev.db
# Postgres로 쓸 때(docker compose의 db 서비스). compose로 띄우면 app 서비스가
# 이 값을 같은 URL로 덮어쓰므로, compose 밖에서 Postgres에 붙을 때만 직접 켜면 된다.
# DATABASE_URL=postgresql+asyncpg://fairway:fairway@db:5432/fairway

JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
STREAM_TOKEN_MINUTES=10

CORS_ORIGINS=https://fairway.click,https://www.fairway.click,https://car-defender-tawny.vercel.app,http://localhost:5173
FRONT_BASE_URL=https://fairway.click
AGENT_IMPL=app.agent.mock:MockAgent

# 레지스트리 이미지를 받아 쓸 때만 지정한다 (예: myid/fairway-app:v1).
# 비워 두면 compose가 로컬 빌드 태그(fairway-app:local)를 쓴다.
# APP_IMAGE=
JOB_TIMEOUT_SECONDS=300
SHUTDOWN_WAIT_SECONDS=30

# S3 백엔드는 인터페이스만 구현돼 있고 실제로 검증하지 않았다. local을 쓴다.
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./data
S3_BUCKET=
S3_REGION=ap-northeast-2

MAIL_BACKEND=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM=no-reply@fairway.click

FFPROBE_BIN=ffprobe
# 브라우저가 못 여는 형식(mp4v·HEVC·.mov·.avi)이 올라오면 업로드 중에 재생용 H.264
# 사본을 만든다. 이 시간을 넘기면 포기하고 원본을 그대로 보여 준다.
FFMPEG_BIN=ffmpeg
TRANSCODE_TIMEOUT_SECONDS=60
